# Copy to saas/.env for the Next.js service. Never commit the filled file.
# The desktop app does not read these values. It reads brand.json for the public API address.

# Neon connection string. Use the pooled URL on Vercel and require SSL (the app does, except for localhost).
DATABASE_URL=postgres://user:password@host/northstar?sslmode=require

# Public origin of this service. Used in email links, device approval, and Paystack callbacks.
# Local: http://127.0.0.1:3000 — Production (Vercel): https://app.bada.com.ng
APP_URL=http://127.0.0.1:3000

# 32-byte key, base64. Required before an administrator can store a provider API key.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEY=

# First administrator. POST /api/admin/bootstrap works once, only for this signed-in email.
ADMIN_EMAIL=

# Paystack secret key. Webhooks are HMAC-SHA512 of the raw body with this key.
PAYSTACK_SECRET_KEY=

# Shared secret for POST or GET /api/cron/billing. Vercel Cron sends Authorization: Bearer this value.
CRON_SECRET=

# Optional email. Without both, verification and reset links are only logged outside production.
RESEND_API_KEY=
MAIL_FROM=

# Platform model keys. Providers stay disabled until an administrator enables them.
# A key stored in the database with SECRETS_KEY overrides the environment variable.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# production hides the development verification URL returned by registration.
NODE_ENV=development

# Security notes (OWASP):
# - Use separate test vs live PAYSTACK_SECRET_KEY; register the webhook only on the matching Paystack mode.
# - CRON_SECRET must be long and random; Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
# - APP_URL must match the browser origin exactly (scheme + host + port) or cookie CSRF checks will block checkout.
# - Never expose PAYSTACK_SECRET_KEY, SECRETS_KEY, or CRON_SECRET to the desktop app or client-side code.
